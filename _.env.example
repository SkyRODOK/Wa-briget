# Port (Railway mengisi PORT otomatis — jangan hardcode di production)
PORT=3000
HOST=0.0.0.0

# Kode negara default (Indonesia = 62)
DEFAULT_COUNTRY_CODE=62

# Batas unduh media dari WhatsApp (bytes). Default 25MB.
MAX_MEDIA_BYTES=26214400

# Folder sesi WhatsApp (di Railway: set ke path Volume, contoh /data/auth_info)
AUTH_DIR=./auth_info

# Opsional: batasi origin Socket.IO (pisah koma). Kosong / * = izinkan semua
# CORS_ORIGIN=https://neochat-production.up.railway.app
CORS_ORIGIN=*
